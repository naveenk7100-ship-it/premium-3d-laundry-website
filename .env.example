# ==============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env.local to customize environment variables.
# Note: Brand identity and contact details are located in src/config/brand.config.ts
# ==============================================================================

# Node Environment
NODE_ENV=development

# Site URL for SEO and OpenGraph Previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Analytics / Tracking ID (Leave empty for demo)
NEXT_PUBLIC_ANALYTICS_ID=
